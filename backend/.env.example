# Server only. Replace locally during F02; never commit real values.
PORT=3001
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
STAFF_WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Copy the exact direct or session-pooler URI from the development project's Connect dialog.
# Keep this value server-only; use TLS for hosted connections. Never commit the real URI.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Absolute path to the CA downloaded from this Supabase project's Database settings.
# Store the certificate outside the repository; TLS certificate and hostname checks stay enabled.
DATABASE_CA_CERT_PATH=C:/PATH/OUTSIDE/REPOSITORY/prod-ca-2021.crt
